ZWT_ENVIRONMENT=development
ZWT_API_PREFIX=/api
ZWT_API_HOST=127.0.0.1
# 端口一律使用 "BOI + 100" 偏移，避免与 BOI 系统（5173/4173/8000）冲突。
ZWT_API_PORT=8100
ZWT_API_WORKERS=1
# 前端开发服务器端口另见 frontend/.env.example，本文件含数据库口令和 BOT 凭证，
# 不提供给 Vite 读取。
ZWT_DATABASE_URL=postgresql+psycopg://zwt_finance_app:change-me@127.0.0.1:5432/zwt_finance
ZWT_ATTACHMENT_ROOT=D:\ZWTFinance\data\attachments
# 模板（xlsx 与 PDF 底版）和泰文字体都随应用发布，默认取仓库里的
# backend/app/assets/，clone 下来不配置也能出票。只有业务批准了新版式时才需要
# 覆盖以下路径——注意 TAX INV 的 xlsx 一旦换掉就必须重新制版，否则 xlsx 与 PDF
# 会印出不同的数字（Initialize-ZwtDev.ps1 会用 sha256 拦住这种情况）。
# ZWT_WHT_TEMPLATE_PATH=D:\ZWTFinance\data\templates\WHT-Template.xlsx
# ZWT_TAX_INVOICE_TEMPLATE_PATH=D:\ZWTFinance\data\templates\TAX-INV-Template.xlsx
# ZWT_WHT_PDF_TEMPLATE_PATH=D:\ZWTFinance\data\templates\WHT-Template.pdf
# ZWT_TAX_INVOICE_PDF_TEMPLATE_PATH=D:\ZWTFinance\data\templates\TAX-INV-Template.pdf
# ZWT_THAI_FONT_PATH=D:\ZWTFinance\data\fonts\Sarabun-Regular.ttf
ZWT_MAX_FILE_MIB=20
ZWT_LOG_LEVEL=INFO
ZWT_BOT_API_BASE_URL=https://gateway.api.bot.or.th
ZWT_BOT_API_ENDPOINT=/Stat-ExchangeRate/v2/DAILY_AVG_EXG_RATE/
# 泰国央行 API Portal（apiportal.bot.or.th）签发的 token。留空则「从 BOT API 同步」
# 按钮会显示未配置并给出配置指引，汇率只能走 BOT Excel 导入。
# 填好后必须重启 API 进程才生效（配置用 lru_cache 缓存）。
ZWT_BOT_API_KEY=
# 认证头。实测央行网关要的是不带 scheme 的 Authorization: <token>；
# 只有央行改口径时才需要动这两项（例如改成 X-IBM-Client-Id 或 Bearer）。
# ZWT_BOT_API_AUTH_HEADER=Authorization
# ZWT_BOT_API_AUTH_SCHEME=
# 跨月区间会按 30 天分块请求，块间停顿秒数。设 0 会被网关限流。
# ZWT_BOT_API_CHUNK_PAUSE_SECONDS=1.0
ZWT_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
ZWT_BOOTSTRAP_ADMIN_USERNAME=admin

# 会话：滑动过期 8 小时，绝对上限 12 小时（超过后无论多活跃都要重新登录）。
ZWT_SESSION_IDLE_MINUTES=480
ZWT_SESSION_ABSOLUTE_MINUTES=720
ZWT_SESSION_COOKIE_NAME=zwt_session
ZWT_CSRF_COOKIE_NAME=zwt_csrf
# Secure Cookie 开关。留空则按 ZWT_ENVIRONMENT 自动判断（production 为 true）。
# 开发期走 http://127.0.0.1:5273，必须为 false 否则浏览器不会回传 Cookie。
# ZWT_SESSION_COOKIE_SECURE=false
